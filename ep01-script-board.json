  "scenes": [
    {
      "id": "sc1",
      "slugline": "外。津海夜市古玩巷 - 夜",
      "beats": [
        {
          "id": "b1a",
          "action": "雨刚停，摊主收摊。赵三姐把铜镜丢上马勺的摊。",
          "dialogue": [
            {
              "who": "赵三姐",
              "line": "收了收了，再照要收钱了。"
            }
          ]
        },
        {
          "id": "b1b",
          "action": "马勺拿起铜镜，按三步验货：拇指在锈上一蹭，凑近闻，再翻过来看镜缘。",
          "dialogue": [
            {
              "who": "马勺",
              "line": "锈往里吃。"
            },
            {
              "who": "马勺",
              "line": "棺木味，不是醋。"
            },
            {
              "who": "马勺",
              "line": "边上是土，不是胶。"
            }
          ]
        },
        {
          "id": "b2",
          "action": "马勺手停住，声音变得专业；说完腿才开始抖。",
          "dialogue": [
            {
              "who": "马勺",
              "line": "锈是从铜里往外吃的，土咬在锈缝里，拇指蹭不掉。这东西出土不过七天。"
            },
            {
              "who": "马勺",
              "line": "三姐，这镜子谁送来的？"
            },
            {
              "who": "赵三姐",
              "line": "一个吃饼的。你爱照不照。"
            }
          ]
        },
        {
          "id": "b3",
          "action": "镜子下压着发黄拓片，马勺像捏烫手的炭，塞给在摊前挑旧纸的林晚。",
          "dialogue": [
            {
              "who": "马勺",
              "line": "这张纸你拿走。上头的字谁看谁倒霉，我贴墙上都嫌它阴。"
            },
            {
              "who": "林晚",
              "line": "正看是乱笔。"
            }
          ]
        },
        {
          "id": "b4",
          "action": "那面土锈铜镜仍摊在桌上，只作物证。林晚从挎包里取出自己的手镜，把拓片斜对着手镜。手镜拍成空镜面，倒字字形后期合成。巷口砖头抱纸箱跑过，看了一眼（不单独提供参考图）。",
          "dialogue": [
            {
              "who": "林晚",
              "line": "反字陵。"
            },
            {
              "who": "林晚",
              "line": "……西坝。"
            }
          ]
        },
        {
          "id": "b5",
          "action": "马勺抱紧保温杯；林晚卷好拓片塞进挎包往外走，马勺跟上。",
          "dialogue": [
            {
              "who": "马勺",
              "line": "西坝泵站，废了十年了。"
            },
            {
              "who": "林晚",
              "line": "废了的地方，才有人挖。"
            },
            {
              "who": "马勺",
              "line": "我这条命是租的，押金还没退。"
            },
            {
              "who": "林晚",
              "line": "那你在上面等。"
            },
            {
              "who": "马勺",
              "line": "我一个人在上面更怕。"
            }
          ]
        }
      ]
    },
    {
      "id": "sc2",
      "slugline": "内。西坝废泵站 - 夜",
      "beats": [
        {
          "id": "b6",
          "action": "手电切开灰尘，锈管滴水。顾沉蹲在地缝边用粉笔画尺标，林晚刚要迈步。",
          "dialogue": [
            {
              "who": "顾沉",
              "line": "别踩。空的。"
            },
            {
              "who": "马勺",
              "line": "谁？"
            },
            {
              "who": "顾沉",
              "line": "量地的。"
            }
          ]
        },
        {
          "id": "b7",
          "action": "林晚蹲到缝边，先把黄铜提灯拴两道细绳打死结，再一寸寸放进缝里。",
          "dialogue": [
            {
              "who": "马勺",
              "line": "你这是钓鱼？"
            },
            {
              "who": "林晚",
              "line": "灯掉下去，就看不见了。"
            }
          ]
        },
        {
          "id": "b8a",
          "action": "灯光往下沉，照出缝底一道青灰石门的门楣。门楣拍成空额，不生成倒刻篆字，字形后期合成。",
          "dialogue": []
        },
        {
          "id": "b8b",
          "action": "林晚举起手镜对着缝口。手镜拍成空镜面，两字翻正由后期合成。",
          "dialogue": [
            {
              "who": "林晚",
              "line": "……是我的名字。"
            }
          ]
        },
        {
          "id": "b9",
          "action": "马勺后退撞上锈管。顾沉在缝边那两个字的正上方用粉笔圈一个圈。",
          "dialogue": [
            {
              "who": "马勺",
              "line": "你别吓我，我心脏是二手的。"
            },
            {
              "who": "顾沉",
              "line": "刻得新。"
            }
          ]
        },
        {
          "id": "b10",
          "action": "缝底传来铁铲吃土的嚓嚓声。顾沉抬手，三人不动。林晚慢慢收灯，绳头沾着一团湿泥。",
          "dialogue": [
            {
              "who": "马勺",
              "line": "底下是人……还是东西？"
            },
            {
              "who": "林晚",
              "line": "人。东西不用铲子。"
            }
          ]
        },
        {
          "id": "b11",
          "action": "铲土声停。缝底传上来一个嚼着东西的客气声音（侯启明画外音，本集不露脸）。三人的脸被缝里灯光照亮一半，谁都没动。",
          "dialogue": [
            {
              "who": "侯启明（画外音）",
              "line": "上面的，灯收一收，晃眼。"
            }
          ]
        }
      ]
    }
  ],
